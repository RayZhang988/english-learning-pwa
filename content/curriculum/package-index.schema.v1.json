{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Survival Travel English Content Package Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "packageVersion",
    "courseId",
    "status",
    "targetLocale",
    "supportLocale",
    "manifestFile",
    "lessonFiles",
    "schemaFiles",
    "documentationFiles",
    "validationFiles",
    "mediaAssets",
    "totals",
    "durationBaselinePolicyFile",
    "durationBaselineTotals",
    "trainingSupplyIndexFile",
    "trainingSupplyIndexSchemaFile",
    "trainingSupplyTotals",
    "reviewContentIndexFile",
    "reviewContentIndexSchemaFile",
    "learningCandidateProjection"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "documentType": {"const": "content-package-index"},
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "courseId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "enum": ["release-candidate", "released", "deprecated"]
    },
    "targetLocale": {"const": "en-US"},
    "supportLocale": {"const": "zh-CN"},
    "manifestFile": {
      "type": "string",
      "pattern": "^content/curriculum/.+\\.json$"
    },
    "lessonFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^content/lessons/.+\\.json$"
      }
    },
    "schemaFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^content/curriculum/.+\\.json$"
      }
    },
    "documentationFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^content/curriculum/.+\\.md$"
      }
    },
    "validationFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^content/curriculum/.+\\.mjs$"
      }
    },
    "mediaAssets": {
      "type": "array",
      "items": {"type": "object"}
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weeks",
        "lessons",
        "learningUnits",
        "vocabularyUnits",
        "listeningUnits",
        "speakingUnits",
        "sceneQuizItems",
        "candidateSeconds"
      ],
      "properties": {
        "weeks": {"type": "integer", "minimum": 1},
        "lessons": {"type": "integer", "minimum": 1},
        "learningUnits": {"type": "integer", "minimum": 3},
        "vocabularyUnits": {"type": "integer", "minimum": 1},
        "listeningUnits": {"type": "integer", "minimum": 1},
        "speakingUnits": {"type": "integer", "minimum": 1},
        "sceneQuizItems": {"type": "integer", "minimum": 3},
        "candidateSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "durationBaselinePolicyFile": {
      "const": "content/curriculum/duration-baseline-authoring.v1.json"
    },
    "durationBaselineTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningUnits",
        "vocabularySeconds",
        "listeningSeconds",
        "speakingSeconds",
        "allUnitsSeconds"
      ],
      "properties": {
        "learningUnits": {"const": 84},
        "vocabularySeconds": {"type": "integer", "minimum": 1},
        "listeningSeconds": {"type": "integer", "minimum": 1},
        "speakingSeconds": {"type": "integer", "minimum": 1},
        "allUnitsSeconds": {"type": "integer", "minimum": 3}
      }
    },
    "trainingSupplyIndexFile": {
      "const": "content/curriculum/training-supply-index.v1.json"
    },
    "trainingSupplyIndexSchemaFile": {
      "const": "content/curriculum/training-supply-index.schema.v1.json"
    },
    "trainingSupplyTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabularyCandidates",
        "listeningCandidates",
        "speakingCandidates",
        "allCandidates"
      ],
      "properties": {
        "vocabularyCandidates": {"type": "integer", "minimum": 1},
        "listeningCandidates": {"type": "integer", "minimum": 1},
        "speakingCandidates": {"type": "integer", "minimum": 1},
        "allCandidates": {"type": "integer", "minimum": 3}
      }
    },
    "reviewContentIndexFile": {
      "const": "content/curriculum/review-content-index.v1.json"
    },
    "reviewContentIndexSchemaFile": {
      "const": "content/curriculum/review-content-index.schema.v1.json"
    },
    "learningCandidateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staticFields", "runtimeField", "runtimeSource"],
      "properties": {
        "staticFields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "contains": {"const": "durationBaseline"},
          "minContains": 1,
          "maxContains": 1
        },
        "runtimeField": {"const": "prerequisitesMet"},
        "runtimeSource": {"const": "learningUnit.prerequisiteUnitIds"}
      }
    }
  }
}
