{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Survival Travel English Lesson Week v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "packageVersion",
    "courseId",
    "week",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "documentType": {"const": "lesson-week"},
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "courseId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "week": {"type": "integer", "minimum": 1, "maximum": 4},
    "lessons": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/lesson"}
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "recommendedDay",
        "titleZh",
        "sceneIds",
        "observableObjectives",
        "learningUnits",
        "sceneQuiz"
      ],
      "properties": {
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "recommendedDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "titleZh": {"type": "string", "minLength": 1},
        "sceneIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "observableObjectives": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "safetyNoteZh": {"type": "string", "minLength": 1},
        "learningUnits": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/learningUnit"},
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {"domain": {"const": "vocabulary"}},
                "required": ["domain"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {"domain": {"const": "listening"}},
                "required": ["domain"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {"domain": {"const": "speaking"}},
                "required": ["domain"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "sceneQuiz": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/quizItem"}
        }
      }
    },
    "learningUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningUnitId",
        "contentRef",
        "domain",
        "difficultyLevel",
        "estimatedSeconds",
        "durationBaseline",
        "tags",
        "prerequisiteUnitIds",
        "activity"
      ],
      "properties": {
        "learningUnitId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "contentRef": {
          "type": "string",
          "pattern": "^lesson://[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9]+/(vocabulary|listening|speaking)$"
        },
        "domain": {
          "enum": ["vocabulary", "listening", "speaking"]
        },
        "difficultyLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "estimatedSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "durationBaseline": {
          "$ref": "#/$defs/durationBaseline"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prerequisiteUnitIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "activity": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": [
                "vocabulary-set",
                "vocabulary-review",
                "listening-dialogue",
                "listening-narrative",
                "listening-announcement",
                "fixed-response",
                "guided-roleplay"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"domain": {"const": "vocabulary"}},
            "required": ["domain"]
          },
          "then": {
            "properties": {
              "durationBaseline": {
                "properties": {
                  "contentType": {
                    "enum": [
                      "vocabulary-set-v1",
                      "vocabulary-review-v1"
                    ]
                  },
                  "fixedSeconds": {"const": 15},
                  "secondsPerItem": {"const": 12},
                  "activeAudioSeconds": {"const": 0},
                  "expectedAudioPlaythroughs": {"const": 0},
                  "secondsPerInteractionStep": {"const": 3},
                  "minimumSeconds": {"const": 90},
                  "maximumSeconds": {"const": 600}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"domain": {"const": "listening"}},
            "required": ["domain"]
          },
          "then": {
            "properties": {
              "durationBaseline": {
                "properties": {
                  "contentType": {
                    "const": "structured-listening-set-v1"
                  },
                  "fixedSeconds": {"const": 20},
                  "secondsPerItem": {"const": 10},
                  "activeAudioSeconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expectedAudioPlaythroughs": {"const": 1},
                  "secondsPerInteractionStep": {"const": 3},
                  "minimumSeconds": {"const": 150},
                  "maximumSeconds": {"const": 900}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"domain": {"const": "speaking"}},
            "required": ["domain"]
          },
          "then": {
            "properties": {
              "durationBaseline": {
                "properties": {
                  "contentType": {
                    "enum": [
                      "fixed-response-v1",
                      "guided-roleplay-v1"
                    ]
                  },
                  "fixedSeconds": {"const": 25},
                  "secondsPerItem": {"const": 36},
                  "activeAudioSeconds": {"const": 0},
                  "expectedAudioPlaythroughs": {"const": 0},
                  "secondsPerInteractionStep": {"const": 4},
                  "minimumSeconds": {"const": 90},
                  "maximumSeconds": {"const": 720}
                }
              }
            }
          }
        }
      ]
    },
    "durationBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contentType",
        "fixedSeconds",
        "itemCount",
        "secondsPerItem",
        "activeAudioSeconds",
        "expectedAudioPlaythroughs",
        "interactionStepCount",
        "secondsPerInteractionStep",
        "minimumSeconds",
        "maximumSeconds"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "contentType": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^|]+$"
        },
        "fixedSeconds": {
          "type": "number",
          "minimum": 0
        },
        "itemCount": {
          "type": "integer",
          "minimum": 1
        },
        "secondsPerItem": {
          "type": "number",
          "minimum": 0
        },
        "activeAudioSeconds": {
          "type": "number",
          "minimum": 0
        },
        "expectedAudioPlaythroughs": {
          "type": "number",
          "minimum": 0
        },
        "interactionStepCount": {
          "type": "integer",
          "minimum": 1
        },
        "secondsPerInteractionStep": {
          "type": "number",
          "minimum": 0
        },
        "minimumSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "quizItem": {
      "type": "object",
      "required": ["id", "domain", "format", "promptZh"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "domain": {
          "enum": ["vocabulary", "listening", "speaking"]
        },
        "format": {
          "enum": ["single-choice", "fixed-response", "intent-matching"]
        },
        "promptZh": {"type": "string", "minLength": 1}
      }
    }
  }
}
