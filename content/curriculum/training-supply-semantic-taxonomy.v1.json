{
  "schemaVersion": 1,
  "documentType": "training-supply-semantic-taxonomy",
  "taxonomyVersion": "1.0.0",
  "normalizationVersion": "semantic-text-v1",
  "matchingPolicy": "rules are evaluated in ascending priority; first match wins; unmatched facts use deterministic lexical-concept identity",
  "rules": [
    {"ruleId":"rule-v1-01","priority":1,"categoryId":"identity-name","patterns":["\\b(name|first name|last name|surname|spell)\\b","姓名|名字|拼写"]},
    {"ruleId":"rule-v1-02","priority":2,"categoryId":"greeting-introduction","patterns":["\\b(hello|hi|nice to meet|introduce|welcome)\\b","你好|见到你|介绍|欢迎"]},
    {"ruleId":"rule-v1-03","priority":3,"categoryId":"origin-nationality-language","patterns":["\\b(from|country|nationality|language|speak english)\\b","来自|国家|国籍|语言"]},
    {"ruleId":"rule-v1-04","priority":4,"categoryId":"time-date-schedule","patterns":["\\b(time|today|tomorrow|yesterday|morning|afternoon|evening|o'clock|schedule|date|week|month|year)\\b","时间|今天|明天|日期|星期|月份|早上|晚上"]},
    {"ruleId":"rule-v1-05","priority":5,"categoryId":"quantity-number-measurement","patterns":["\\b(number|how many|amount|total|meter|kilometer|mile|kilogram|pound|liter)\\b","数字|多少|数量|公里|英里|公斤|磅"]},
    {"ruleId":"rule-v1-06","priority":6,"categoryId":"money-price-payment","patterns":["\\b(price|cost|cash|card|credit|pay|payment|dollar|currency|exchange|change|receipt|refund|fee)\\b","价格|付款|现金|信用卡|美元|货币|兑换|收据|退款|费用"]},
    {"ruleId":"rule-v1-07","priority":7,"categoryId":"airport-checkin","patterns":["\\b(check-in|check in|boarding pass|airline counter|passport)\\b","值机|登机牌|航空柜台|护照"]},
    {"ruleId":"rule-v1-08","priority":8,"categoryId":"flight-gate-boarding","patterns":["\\b(flight|gate|board|boarding|departure|arrival|terminal|connection|layover|delay|cancelled)\\b","航班|登机口|登机|出发|到达|航站楼|转机|延误|取消"]},
    {"ruleId":"rule-v1-09","priority":9,"categoryId":"baggage-luggage","patterns":["\\b(baggage|luggage|suitcase|bag|claim|carousel|lost and found|overweight)\\b","行李|行李箱|传送带|失物|超重"]},
    {"ruleId":"rule-v1-10","priority":10,"categoryId":"immigration-customs","patterns":["\\b(immigration|customs|declare|declaration|visa|officer|purpose of visit)\\b","入境|海关|申报|签证|官员|访问目的"]},
    {"ruleId":"rule-v1-11","priority":11,"categoryId":"ground-transport-ticket","patterns":["\\b(bus|train|subway|metro|tram|station|platform|ticket|fare|transfer)\\b","公交|火车|地铁|车站|站台|车票|票价|换乘"]},
    {"ruleId":"rule-v1-12","priority":12,"categoryId":"taxi-ride-hailing","patterns":["\\b(taxi|cab|driver|ride|drop me|pick me up|meter)\\b","出租车|司机|打车|送我|接我|计价器"]},
    {"ruleId":"rule-v1-13","priority":13,"categoryId":"driving-car-rental","patterns":["\\b(car|rental|rent|drive|driving|license|gas|petrol|parking|insurance)\\b","汽车|租车|驾驶|驾照|加油|停车|保险"]},
    {"ruleId":"rule-v1-14","priority":14,"categoryId":"directions-location","patterns":["\\b(where|direction|left|right|straight|near|far|across|next to|corner|map|address)\\b","哪里|方向|左边|右边|直走|附近|地图|地址"]},
    {"ruleId":"rule-v1-15","priority":15,"categoryId":"hotel-reservation-checkin","patterns":["\\b(hotel|reservation|booking|room|front desk|reception|check out|checkout)\\b","酒店|预订|房间|前台|退房"]},
    {"ruleId":"rule-v1-16","priority":16,"categoryId":"hotel-room-facilities","patterns":["\\b(key|towel|shower|air conditioning|wifi|elevator|floor|breakfast included|housekeeping)\\b","房卡|毛巾|淋浴|空调|wifi|电梯|楼层|客房服务"]},
    {"ruleId":"rule-v1-17","priority":17,"categoryId":"food-menu-ordering","patterns":["\\b(menu|order|dish|meal|food|breakfast|lunch|dinner|restaurant|table|waiter|server)\\b","菜单|点餐|菜品|食物|早餐|午餐|晚餐|餐厅|桌子|服务员"]},
    {"ruleId":"rule-v1-18","priority":18,"categoryId":"food-diet-allergy","patterns":["\\b(allergy|allergic|vegetarian|vegan|gluten|spicy|ingredient|without|no dairy)\\b","过敏|素食|纯素|麸质|辣|配料|不要|乳制品"]},
    {"ruleId":"rule-v1-19","priority":19,"categoryId":"shopping-product","patterns":["\\b(shop|store|buy|product|size|color|try on|fit|available|stock)\\b","商店|购买|商品|尺码|颜色|试穿|合身|库存"]},
    {"ruleId":"rule-v1-20","priority":20,"categoryId":"sightseeing-attraction","patterns":["\\b(museum|park|tour|attraction|sightseeing|view|photo|camera|entrance|open|closed)\\b","博物馆|公园|游览|景点|观光|照片|入口|开放|关闭"]},
    {"ruleId":"rule-v1-21","priority":21,"categoryId":"toilet-restroom","patterns":["\\b(restroom|bathroom|toilet|washroom)\\b","洗手间|卫生间|厕所"]},
    {"ruleId":"rule-v1-22","priority":22,"categoryId":"phone-internet-connectivity","patterns":["\\b(phone|sim|data|internet|wifi|wi-fi|password|signal|network|charger|outlet)\\b","手机|电话卡|流量|网络|wifi|密码|信号|充电器|插座"]},
    {"ruleId":"rule-v1-23","priority":23,"categoryId":"health-symptom","patterns":["\\b(sick|pain|hurt|fever|cough|headache|stomach|dizzy|doctor|hospital|clinic)\\b","生病|疼|受伤|发烧|咳嗽|头痛|胃|头晕|医生|医院|诊所"]},
    {"ruleId":"rule-v1-24","priority":24,"categoryId":"medicine-pharmacy","patterns":["\\b(medicine|medication|pharmacy|drugstore|pill|tablet|prescription|dose)\\b","药|药店|药片|处方|剂量"]},
    {"ruleId":"rule-v1-25","priority":25,"categoryId":"emergency-safety","patterns":["\\b(emergency|help|police|ambulance|fire|danger|safe|lost|stolen)\\b","紧急|帮助|警察|救护车|火灾|危险|安全|丢失|被偷"]},
    {"ruleId":"rule-v1-26","priority":26,"categoryId":"politeness-request","patterns":["\\b(please|could you|can you|would you|excuse me|sorry|thank|thanks)\\b","请|可以吗|打扰|对不起|谢谢"]},
    {"ruleId":"rule-v1-27","priority":27,"categoryId":"confirmation-clarification","patterns":["\\b(repeat|again|understand|mean|correct|confirm|slowly|write it down)\\b","重复|再说|理解|意思|正确|确认|慢一点|写下来"]},
    {"ruleId":"rule-v1-28","priority":28,"categoryId":"weather-clothing","patterns":["\\b(weather|rain|sunny|cold|hot|warm|coat|umbrella)\\b","天气|下雨|晴天|冷|热|温暖|外套|雨伞"]},
    {"ruleId":"rule-v1-29","priority":29,"categoryId":"family-person","patterns":["\\b(family|friend|mother|father|parent|child|children|husband|wife|person|people)\\b","家人|朋友|母亲|父亲|父母|孩子|丈夫|妻子|人"]},
    {"ruleId":"rule-v1-30","priority":30,"categoryId":"object-description","patterns":["\\b(big|small|long|short|new|old|good|bad|beautiful|different|same)\\b","大|小|长|短|新|旧|好|坏|漂亮|不同|相同"]}
  ]
}
